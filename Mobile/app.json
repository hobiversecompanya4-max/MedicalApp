{
  "expo": {
    "name": "Panchawati Meds",
    "slug": "panchawati-meds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbfefe"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.panchawatimeds.app"
    },
    "android": {
      "package": "com.panchawatimeds.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0f766e"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Panchawati Meds to access your photo library so you can upload a prescription image.",
          "cameraPermission": "Allow Panchawati Meds to use your camera to capture a prescription image."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:5000/api"
    }
  }
}
